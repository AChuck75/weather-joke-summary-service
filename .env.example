# Client key required by POST /summary. Replace with a long, random value.
SERVICE_API_KEY=your_service_api_key
# Credentials for external providers. Replace all placeholder values.
WEATHER_API_KEY=your_openweathermap_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Provider endpoints and model selection.
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
JOKE_API_URL=https://v2.jokeapi.dev/joke/Any
ANTHROPIC_MESSAGES_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Operational limits.
EXTERNAL_TIMEOUT_SECONDS=8
MAX_SUMMARY_TEXT_LENGTH=5000
SUMMARY_MAX_WORDS=120
SUMMARY_MAX_TOKENS=180
USER_AGENT=weather-joke-summary-service/1.0